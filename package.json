{
  "name": "crystalline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crystalline - a match-3 research build. All monetization is simulated; no real currency, no ad SDKs, no network calls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "python3 tools/build_assets.py",
    "assets:harbor": "python3 tools/bake_harbor.py",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && node tools/build-android-apk.mjs",
    "android:keystore": "node tools/generate-upload-keystore.mjs",
    "android:bundle": "npm run cap:sync && node tools/build-android-release.mjs",
    "android:release": "npm run android:bundle",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2"
  }
}
